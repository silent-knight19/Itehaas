# Itehaas server env — copy to `.env` and fill STRONG values. Never commit `.env`.
# Generate secrets: openssl rand -base64 48  (use 32+ chars, distinct values)
#
# Production (self-hosted) — all three mandatory, boot fails closed if missing/weak
# (see server/src/config.ts validateStartupConfig + docker-compose.yml :? guards):
#   NODE_ENV=production
#   HOST=127.0.0.1
#   DATABASE_URL=postgres://itehaas:<12+char-strong-pwd-no-weak-words>@db:5432/itehaas
#   COOKIE_SECRET=<32+ random, distinct from SECRET_ENCRYPTION_KEY>
#   SECRET_ENCRYPTION_KEY=<32+ random, distinct from COOKIE_SECRET>

# --- Development only (local laptop, never production) ---
# NOTE: values below intentionally FAIL production validation (contain
# change-me patterns), so copying this file to prod without rotation crashes at boot.
DATABASE_URL=postgres://itehaas:CHANGEME@localhost:5432/itehaas
REPOS_ROOT=./data/repos
ITEHAAS_BIN=../target/debug/itehaas
PORT=3001
HOST=127.0.0.1
COOKIE_SECRET=change-me-in-production-override-required-0000
SECRET_ENCRYPTION_KEY=change-me-in-production-override-required-too-1111
NODE_ENV=development
