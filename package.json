{
  "name": "itehaas",
  "private": true,
  "version": "0.1.0",
  "description": "Git-inspired VCS + platform — monorepo root",
  "scripts": {
    "build:vcs": "cargo build -p itehaas",
    "test:vcs": "cargo test -p itehaas",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.19",
      "next": "14.2.35"
    }
  }
}
